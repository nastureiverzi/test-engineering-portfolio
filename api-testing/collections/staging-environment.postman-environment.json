    {
      "name": "Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "pm.environment.set(\"bookingId\", response.bookingid);\r",
              "\r",
              "pm.test(\"Booking created successfully\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "\r",
              "    const response = pm.response.json();\r",
              "    pm.expect(response).to.have.property('bookingid');\r",
              "    pm.expect(response.booking.firstname).to.eql('Raluca');\r",
              "    pm.expect(response.booking.lastname).to.eql('Botas');\r",
              "    pm.expect(response.booking.totalprice).to.eql(300);\r",
              "    pm.expect(response.booking.depositpaid).to.be.true;\r",
              "    pm.expect(response.booking.bookingdates.checkin).to.eql('2025-03-30');\r",
              "    pm.expect(response.booking.bookingdates.checkout).to.eql('2025-04-03');\r",
              "    pm.expect(response.booking.additionalneeds).to.eql('Breakfast');\r",
              "\r",
              "    \r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\": \"Raluca\",\r\n    \"lastname\" : \"Botas\",\r\n    \"totalprice\" : 300,\r\n    \"depositpaid\" : true,\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"2025-03-30\",\r\n        \"checkout\" : \"2025-04-03\"\r\n    },\r\n    \"additionalneeds\" : \"Breakfast\"\r\n}"
        },
        "url": {
          "raw": "{{baseUrl}}booking",
          "host": [
            "{{baseUrl}}booking"
          ]
        }
      },
      "response": []
    },
