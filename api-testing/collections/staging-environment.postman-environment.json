    {
      "name": "Create Booking Sql Injection",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"API accepts SQL injection string safely\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json()\r",
              "pm.test(\"Malicious string stored as text, not executed\", () => {\r",
              "    pm.expect(response.booking.firstname).to.include(\"Robert\");\r",
              "});\r",
              "\r",
              "pm.test(\"Booking created successfully\", () => {\r",
              "    pm.expect(response.bookingid).to.exist;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"firstname\":  \"Robert'; DROP TABLE bookings;--\",\r\n    \"lastname\" : \"SqlInjection\",\r\n    \"totalprice\" : 300,\r\n    \"depositpaid\" : true,\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"2025-03-30\",\r\n        \"checkout\" : \"2025-04-3\"\r\n    },\r\n    \"additionalneeds\" : \"Dinner\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
