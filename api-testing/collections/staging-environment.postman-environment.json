    {
      "name": "Auth Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Token received\", () => {\r",
              "    pm.expect(pm.response.json().token).to.exist;\r",
              "});\r",
              "\r",
              "// Save token to environment/collection variable\r",
              "pm.environment.set(\"authToken\", pm.response.json().token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disabledSystemHeaders": {
          "content-type": true
        }
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"admin\", \r\n    \"password\": \"password123\"\r\n}"
        },
        "url": {
          "raw": "{{baseUrl}}auth",
          "host": [
            "{{baseUrl}}auth"
          ]
        },
        "description": "Run this test before UPDATE and DELTE reuquests that require authentication"
      },
      "response": []
    },
