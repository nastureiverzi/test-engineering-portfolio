            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\": \"Robert\",\r\n    \"lastname\" : \"Doe\",\r\n    \"totalprice\" : \"all the dollars\",\r\n    \"depositpaid\" : true,\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"2025-03-30\",\r\n        \"checkout\" : \"2025-04-3\"\r\n    },\r\n    \"additionalneeds\" : \"Breakfast\"\r\n}"
        },
        "url": {
          "raw": "{{baseUrl}}booking",
          "host": [
            "{{baseUrl}}booking"
          ]
        },
        "description": "**BUG - Poor Data Validation**\n\nWhen sending invalid data type (string instead of number for totalprice), API returns 200 and saves booking with null value instead of rejecting the request.\n\nExpected: 400 Bad Request with error message\n\nActual: 200 OK, totalprice saved as null"
      },
